<!DOCTYPE html>
<html>
  <head>
    <% include ../partials/header.ejs %>
    <style>
      .row {
        height: 40px;
      }
    </style>
  </head>

  <body>
    <% include ../partials/nav.ejs %>

    <div class="container">
      <div class="card bg-light">
        <article class="card-body center-block" style="max-width: 800px;">
          <h4 class="card-title mt-3 text-center">Communications Preferences</h4>
          <p class="text-center"><img alt="Brand" src="https://www.twilio.com/docs/static/company/img/logos/red/twilio-logo-red.ccf24b029.png" height="32px" /></p>
          <br />
          <p class="lead">Thanks for signing up <span id="full_name"></span>! Setup and test your communications preferences here!</p>

          <div class="container-fluid">
            <div class="row">
              <div class="col-xs-4"><h4>Alert</h4></div>
              <div class="col-xs-2"><h4>Email</h4></div>
              <div class="col-xs-2"><h4>SMS</h4></div>
              <div class="col-xs-2"><h4>Call</h4></div>
              <div class="col-xs-2"><h4>Test</h4></div>
            </div>
            <hr />
            <div class="row">
              <form class="form-inline" id="order-confirmation">
                <div class="col-xs-4">Order Confirmations</div>
                <div class="col-xs-2">
                  <div class="form-group">
                    <div class="toggle-switch">
                      <input id="oc-email" name="oc-email" type="checkbox" />
                      <label for="oc-email" class="label-primary"></label>
                    </div>
                  </div>
                </div>
                <div class="col-xs-2">
                  <div class="form-group">
                    <div class="toggle-switch">
                      <input id="oc-sms" name="oc-sms" type="checkbox" />
                      <label for="oc-sms" class="label-primary"></label>
                    </div>
                  </div>
                </div>
                <div class="col-xs-2">
                  <div class="form-group">
                    <div class="toggle-switch">
                      <input id="oc-call" name="oc-call" type="checkbox" />
                      <label for="oc-call" class="label-primary"></label>
                    </div>
                  </div>
                </div>
                <div class="col-xs-2"><button type="submit" class="btn btn-default">Test</button></div>
              </form>
            </div>

            <hr />
            <div class="row">
              <form class="form-inline" id="fraud-alert">
                <div class="col-xs-4">Fraud Alerts</div>
                <div class="col-xs-2">
                  <div class="form-group">
                    <div class="toggle-switch">
                      <input id="fa-email" name="fa-email" type="checkbox" />
                      <label for="fa-email" class="label-primary"></label>
                    </div>
                  </div>
                </div>
                <div class="col-xs-2">
                  <div class="form-group">
                    <div class="toggle-switch">
                      <input id="fa-sms" name="fa-sms" type="checkbox" />
                      <label for="fa-sms" class="label-primary"></label>
                    </div>
                  </div>
                </div>
                <div class="col-xs-2">
                  <div class="form-group">
                    <div class="toggle-switch">
                      <input id="fa-call" name="fa-call" type="checkbox" />
                      <label for="fa-call" class="label-primary"></label>
                    </div>
                  </div>
                </div>
                <div class="col-xs-2"><button type="submit" class="btn btn-default">Test</button></div>
              </form>
            </div>
          </div>
          <div>
              <hr>
              <p class="lead">Now that we have our customer's preferences, SMS Messages can be sent using this app:</p>
            <a href="https://marketingsmsapp-5875.twil.io/index.html">SMS Marketing Campaigns</a>
          </div>
          <div>
            <hr>
            <h4 class="text-center">Account Verification Details</h4>
            <p class="lead text-center">View the verification results from your signup</p>
            <div class="text-center">
              <a href="/lookup-results" class="btn btn-info btn-lg">View Lookup Results</a>
            </div>
          </div>
        </article>
      </div>
    </div>
    <script>
      $(document).ready(function() {
        let first_name = localStorage.getItem("19q3.first_name");
        let last_name = localStorage.getItem("19q3.last_name");
        let email_address = localStorage.getItem("19q3.email_address");
        let mobile_phone_number = localStorage.getItem("19q3.mobile_phone_number");

        $("#full_name").html(first_name + " " + last_name);

        $("#order-confirmation").submit(function(e) {
          e.preventDefault();

          let email = $("#oc-email").is(":checked");
          if (email) $.get("/email/order-confirmation/" + email_address);

          let sms = $("#oc-sms").is(":checked");
          if (sms) $.get("/sms/order-confirmation/" + mobile_phone_number);

          let call = $("#oc-call").is(":checked");
          if (call) $.get("/call/order-confirmation/" + mobile_phone_number);
        });

        $("#fraud-alert").submit(function(e) {
          e.preventDefault();

          let email = $("#fa-email").is(":checked");
          if (email) $.get("/email/fraud-alert/" + email_address);

          let sms = $("#fa-sms").is(":checked");
          if (sms) $.get("/sms/fraud-alert/" + mobile_phone_number);

          let call = $("#fa-call").is(":checked");
          if (call) $.get("/call/fraud-alert/" + mobile_phone_number);
        });
      });
    </script>
  </body>
</html>
